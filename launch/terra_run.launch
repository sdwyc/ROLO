<launch>
    <param name="use_sim_time" value="true" />
    <arg name="project" default="terra"/>
    
    <!-- Parameters -->
    <rosparam file="$(find terra)/config/params.yaml" command="load" />
    <!-- <rosparam file="$(find terra)/config/params_os.yaml" command="load" /> -->

    <node pkg="tf" type="static_transform_publisher" name="velodyne2base" args="0 0 0 0 0 0 /base_link /velodyne 1"/>
    <!-- <node pkg="tf" type="static_transform_publisher" name="base2lidar" args="0 0 0 0 0 1.57 /base_link /os_sensor 1" /> -->

    <!--- LOAM -->
    <include file="$(find terra)/launch/module_loam.launch" />

    <!-- Prior Prediction -->
    <include file="$(find terra)/launch/module_prior.launch" />

    <!--- Robot State TF -->
    <!-- <include file="$(find terra)/launch/include/module_robot_state_publisher.launch" /> -->

    <!--- Run Rviz-->
    <include file="$(find terra)/launch/module_rviz.launch" />

</launch>
